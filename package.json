{
  "name": "@noenv/cli",
  "version": "0.1.0",
  "description": "Run commands with secrets, without committing secrets. Just-in-time environment injection.",
  "type": "module",
  "bin": {
    "noenv": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && cd dist && node --test",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "noenv": "node dist/index.js"
  },
  "keywords": [
    "env",
    "dotenv",
    "secrets",
    "secret-management",
    "environment-variables",
    "cli",
    "security"
  ],
  "license": "MIT",
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
